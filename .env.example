# ---- Adapters: swap implementations without touching the core ----
LLM_PROVIDER=fake               # fake | openai | anthropic
EMBEDDINGS_PROVIDER=hashing     # hashing | openai
VECTOR_STORE=pgvector           # memory | pgvector

# ---- LLM (only needed when LLM_PROVIDER != fake) ----
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_SMALL_MODEL=                # cheap/fast model, check provider docs for current names
LLM_LARGE_MODEL=                # stronger model for reasoning questions

# ---- Embeddings ----
EMBEDDING_MODEL=
EMBEDDING_DIM=1024              # must match the embedding model; changing it = re-index

# ---- Retrieval ----
TOP_K=4
MIN_SCORE=0.05
CHUNK_SIZE=400
CHUNK_OVERLAP=80

# ---- Infrastructure ----
# docker-compose overrides the host to "db" inside containers
DATABASE_URL=postgresql://bodeguero:bodeguero@localhost:5432/bodeguero
DATA_DIR=data

# ---- Telegram ----
TELEGRAM_BOT_TOKEN=             # from @BotFather; empty = replies are only logged
TELEGRAM_WEBHOOK_SECRET=change-me-to-a-long-random-string

LOG_LEVEL=INFO
